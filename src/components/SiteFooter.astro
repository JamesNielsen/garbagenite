---
import { Icon } from "astro-icon/components";
---

<footer class="site-footer">
  <p>Garbage Nite. Old photos and original spirit preserved.</p>
  <div class="footer-links">
    <a
      class="social-link"
      href="https://facebook.com/Garbagenite"
      rel="noreferrer"
      target="_blank"
      aria-label="Garbage Nite Facebook group"
    >
      <Icon name="simple-icons:facebook" size={32} aria-hidden="true" />
    </a>
    <a
      class="social-link"
      href="https://github.com/JamesNielsen/garbagenite"
      rel="noreferrer"
      target="_blank"
      aria-label="Garbage Nite GitHub repository"
    >
      <Icon name="simple-icons:github" size={32} aria-hidden="true" />
    </a>
  </div>
</footer>
