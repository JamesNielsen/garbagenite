---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/Layout.astro"; // Adjust path to match your theme's layout

// 1. Resolve the path to the public directory
const originalsDir = path.join(process.cwd(), "public", "Original");

// 2. Read the directory and filter out system files (like .DS_Store)
let images: string[] = [];
try {
  images = fs.readdirSync(originalsDir).filter((file) => {
    return [".jpg", ".jpeg", ".png", ".webp", ".gif"].includes(
      path.extname(file).toLowerCase(),
    );
  });
} catch (error) {
  console.error("Could not read /public/Original directory:", error);
}
---

<BaseLayout title="Original Archives">
  <main class="gallery-container">
    <h1>The Original Archives</h1>
    <p>A look back at the classic era. Unfiltered and uncompressed.</p>

    <div class="grid">
      {
        images.map((img) => (
          <div class="card">
            {/* Note: Files in /public are served from the root, so omit "/public" from the src attribute */}
            <img src={`/Original/${img}`} alt={img} loading="lazy" />
            <span class="filename">{img}</span>
          </div>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  .gallery-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .card {
    border: 1px solid #333;
    border-radius: 8px;
    overflow: hidden;
    background: #111;
    display: flex;
    flex-direction: column;
  }
  .card img {
    width: 100%;
    height: 250px;
    object-fit: cover; /* Keeps the grid uniform */
    transition: transform 0.2s ease;
  }
  .card img:hover {
    transform: scale(1.02);
  }
  .filename {
    padding: 0.75rem;
    font-size: 0.85rem;
    font-family: monospace;
    color: #888;
    border-top: 1px solid #222;
    text-align: center;
  }
</style>
