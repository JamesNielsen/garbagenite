---
import SiteLayout from "../layouts/SiteLayout.astro";
import { archivePhotos, site } from "../content/site";
import { getCollection } from "astro:content";

const featuredPhotos = archivePhotos.slice(0, 4);

const recentNitesRaw = await getCollection("nites");
const recentNites = recentNitesRaw
  .sort((a, b) => {
    const dateA = new Date(a.data.date).getTime();
    const dateB = new Date(b.data.date).getTime();

    const isAInvalid = isNaN(dateA);
    const isBInvalid = isNaN(dateB);

    if (isAInvalid && isBInvalid) return 0;
    if (isAInvalid) return -1;
    if (isBInvalid) return 1;

    return dateB - dateA;
  })
  .slice(0, 2);
---

<SiteLayout>
  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">The original neighborhood tradition</p>
        <h1>Take out the trash. Stay out a little longer.</h1>
        <p>
          Garbage Nite started as a simple weekly chore and became an excuse to
          catch up with neighbors, crack open a drink, and turn the driveway
          into a standing appointment.
        </p>
        <div class="hero-actions" aria-label="Primary links">
          <a class="button" href="/archive">View the archives</a>
          <a class="button" href="/nites">See into the Nite</a>
        </div>
      </div>
      <div class="hero-media hero-logo">
        <img src="/gn-logo-new.png" alt="Garbage Nite original logo" />
      </div>
    </section>

    <section class="story-section">
      <div>
        <p class="eyebrow">A bit of history</p>
        <h2>What is Garbage Nite?</h2>
      </div>
      <div class="story-copy">
        <p>
          While living in California, Johnny was introduced to the weekly event
          of moving trash cans out to the street. He had grown up in Montana
          where there were alleys, and you just dumped your garbage in cans in
          the dark alley and that was that. But there are few alleys in
          California.
        </p>
        <p>
          Before long, the neighbors would see each other outside, the beer and
          wine would come out, and there it was: Garbage Nite. A chore became a
          reason to stay connected.
        </p>
        <p>
          The Minnesota version brought regulars, winter weather, mosquitoes,
          food from time to time, and an open invitation. Any and all neighbors
          were welcome.
        </p>
        <blockquote>
          Garbage Nite is a chance to stay connected with your neighbors, and a
          chance for the guys to just hang out.
        </blockquote>
      </div>
    </section>

    <section class="photo-band" aria-labelledby="archive-heading">
      <div class="section-heading">
        <p class="eyebrow">Original archive</p>
        <h2 id="archive-heading">A look into the past.</h2>
        <a href="/archive">Open the archive</a>
      </div>
      <div class="photo-grid">
        {
          featuredPhotos.map((photo) => (
            <article class="photo-card">
              <img src={photo.src} alt={photo.title} loading="lazy" />
              <div>
                <h3>{photo.title}</h3>
                <p>{photo.caption}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="live-section" aria-labelledby="live-heading">
      <div>
        <p class="eyebrow">Driveway updates</p>
        <h2 id="live-heading">Posts from Garbage Nite.</h2>
        <p>
          Follow the latest posts from the guys during Garbage Nite, then head
          to the shared Google Photos album for pictures from the driveway.
        </p>
      </div>
      <div class="nite-list">
        {
          recentNites.map((nite) => (
            <article>
              <p><a href="/nites#nites-section">{nite.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", })}</a></p>
              <h3>{nite.data.title}</h3>
              <span><strong>Attendees: </strong>{nite.data.attendees}</span>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</SiteLayout>
