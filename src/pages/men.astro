---
import SiteLayout from "../layouts/SiteLayout.astro";

const crew = [
  {
    name: "Johnny",
    role: "The Founder",
    src: "/Original/john.jpg",
    description: "Johnny brought the concept of Garbage Nite back from California. A Montana native who grew up with dark alley dumpsters, he fell in love with CA's driveway neighborhood culture and started the weekly driveway tradition in Minnesota.",
  },
  {
    name: "Al",
    role: "The Attendance Legend",
    src: "/Original/Al_2_2010.jpg",
    description: "According to legend, Al has never missed a single Garbage Nite. Through the subzero Minnesota winters and the mosquito-thick summer heats, Al's presence is as guaranteed as the garbage trucks themselves.",
  },
  {
    name: "Dan",
    role: "The Game Hunter",
    src: "/Original/Dan_2_2010.jpg",
    description: "An early regular from the Minnesota era who frequently provided the 'fresh kill' food for the guys. Along with Al, Dan represents the backbone of the driveway crew.",
  },
  {
    name: "Andy (aka Santa Andy)",
    role: "The Festive Spirit",
    src: "/Original/Santa Andy.jpg",
    description: "Whether it's bringing holiday cheer or showing up as the resident Santa, Andy keeps the driveway lively no matter the season.",
  },
  {
    name: "Rick",
    role: "The Neighborhood Anchor",
    src: "/Original/Rick_2_2010.jpg",
    description: "A classic neighborhood fixture and long-standing regular. Always ready with a cold drink and a good story.",
  },
  {
    name: "Scott",
    role: "The Early Crew",
    src: "/Original/scott_2_2010.jpg",
    description: "Part of the original photo set and early driveway gatherings, helping cement the weekly schedule.",
  },
  {
    name: "Cal",
    role: "The Keeper of the Clock",
    src: "/Original/Cal and the clock.jpg",
    description: "Cal represents the timeless spirit of hanging out. Famous for pacing the night and keeping the guys laughing.",
  },
];
---

<SiteLayout
  title="Garbage Men"
  description="Meet the founders, the regulars, and the neighborhood crew behind Garbage Nite."
>
  <main>
    <section class="page-intro">
      <p class="eyebrow">The Crew</p>
      <h1>Garbage Men</h1>
      <p>
        The weekly driveway appointment doesn't happen by itself. Meet the founders,
        regulars, and neighborhood characters who make Garbage Nite what it is.
      </p>
    </section>

    <section class="crew-section" aria-label="Garbage Men Profiles">
      <div class="crew-grid">
        {
          crew.map((member) => (
            <article class="crew-card">
              <div class="crew-image-wrapper">
                <img src={member.src} alt={member.name} loading="lazy" />
              </div>
              <div class="crew-details">
                <span class="crew-role">{member.role}</span>
                <h2>{member.name}</h2>
                <p>{member.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .crew-section {
    padding: 24px 0 72px;
  }

  .crew-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 32px;
  }

  .crew-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper-strong);
    box-shadow: 0 8px 24px rgba(32, 31, 27, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .crew-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(32, 31, 27, 0.1);
  }

  .crew-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--line);
    border-bottom: 1px solid var(--line);
  }

  .crew-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    filter: grayscale(15%);
    transition: filter 0.3s ease;
  }

  .crew-card:hover .crew-image-wrapper img {
    filter: grayscale(0%);
  }

  .crew-details {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 24px;
  }

  .crew-role {
    margin-bottom: 8px;
    color: var(--rust);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .crew-details h2 {
    margin: 0 0 12px;
    font-size: 1.8rem;
    color: var(--ink);
  }

  .crew-details p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @media (max-width: 560px) {
    .crew-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
